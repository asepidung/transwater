# Salin ke /home/USER/artic-data/.env.production di server, lalu isi. JANGAN commit yang sudah terisi.
# Format: KEY=value tanpa spasi di sekitar "=" dan tanpa tanda kutip.

NODE_ENV=production
PORT=3010

# Buat acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Database dan foto di luar folder aplikasi (deploy ulang tidak menghapusnya)
DATABASE_URL=file:/home/USER/artic-data/artic.db
MEDIA_DIR=/home/USER/artic-data/media
BACKUP_DIR=/home/USER/artic-data/backups

# Alamat publik dan izin indeks (dibaca saat BUILD)
# Staging:    NEXT_PUBLIC_SITE_URL=https://staging.artic.co.id   ALLOW_INDEXING=(kosong)
# Produksi:   NEXT_PUBLIC_SITE_URL=https://artic.co.id           ALLOW_INDEXING=true
NEXT_PUBLIC_SITE_URL=
ALLOW_INDEXING=

# Banner "Mockup, data contoh": true di staging, kosongkan saat go-live
NEXT_PUBLIC_DRAFT_BANNER=true

# Notifikasi email form penawaran (boleh dikosongkan dulu)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Salinan backup di luar VPS (contoh rclone), opsional sampai go-live
OFFSITE_CMD=

# Tombol AI di admin (Sempurnakan / Buat versi Inggris). Jangan diisi manual di repo:
# jalankan `bash ~/app/deploy/set-gemini.sh` di server (kunci diketik tersembunyi dan diuji dulu).
# Kunci dari https://aistudio.google.com/apikey. Model bisa diganti (urut: utama, cadangan).
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
