# Salin ke .env.local (lokal) atau isi sebagai environment variable di server. JANGAN commit nilai asli.

# Kunci rahasia Payload (sesi login, enkripsi token). Buat acak, panjang, dan simpan aman.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mengganti nilai ini setelah ada akun akan membuat semua sesi login tidak berlaku.
PAYLOAD_SECRET=

# Lokasi database SQLite. WAJIB di produksi, dan sebaiknya di luar folder aplikasi
# supaya deploy ulang tidak menghapusnya. Folder harus sudah ada dan bisa ditulis.
# Lokal (default jika kosong): file:./data/artic.db
# Produksi contoh:             file:/home/USER/artic-data/artic.db
DATABASE_URL=file:./data/artic.db

# Lokasi file upload (foto). Opsional. Default: ./media
# Produksi contoh: /home/USER/artic-data/media
MEDIA_DIR=

# Alamat publik situs (tanpa slash di akhir): untuk canonical, sitemap, Open Graph.
# Dibaca saat BUILD, jadi isi sebelum `npm run build`. Contoh produksi: https://artic.co.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Izinkan Google mengindeks situs. Biarkan kosong di lokal/staging (otomatis noindex + robots.txt
# memblokir semua). Set true HANYA saat build untuk produksi. Dibaca saat BUILD.
ALLOW_INDEXING=

# Tampilkan banner "Mockup, data contoh" di situs. true hanya untuk lokal/staging.
# WAJIB dimatikan (kosongkan atau false) saat go-live.
NEXT_PUBLIC_DRAFT_BANNER=true

# Notifikasi email untuk form penawaran. Kosongkan SMTP_HOST di lokal: email hanya ditulis ke log.
# NOTIFY_EMAIL = penerima notifikasi (boleh beberapa, pisahkan koma).
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
# true untuk port 465 (SSL langsung); false untuk 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Alamat pengirim; sebaiknya di domain sendiri agar tidak masuk spam. Contoh: no-reply@artic.co.id
EMAIL_FROM=
